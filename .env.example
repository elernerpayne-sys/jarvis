# Copy to .env.local and fill in to leave demo mode.
# With both values empty the app runs on sample data and skips sign-in.
#
# These two are the only values the browser ever sees. Both are public by
# design; row-level security is what protects the data. Every secret
# (ElevenLabs, Jarvis backend) lives in Supabase edge functions instead.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API keys → Publishable key (sb_publishable_…)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older projects: the legacy "anon" key works too. Use one or the other.
# VITE_SUPABASE_ANON_KEY=
