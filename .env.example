# Jarvis settings. Two kinds live here:
#
#   1. The app's build settings (VITE_…). These end up in the browser, so
#      none of them is ever a secret.
#   2. The Jarvis server's settings (everything else). These stay on the
#      server and are never sent to the browser or written to its logs. Set
#      them on your host (Railway or Render → Variables), or copy this file
#      to .env.local for local use.
#
# With nothing set at all, the app runs in demo mode on sample data.

# ════════════════════════════════════════════════════════════════════════════
# 1. The app (build time)
# ════════════════════════════════════════════════════════════════════════════

# Where the app finds its backend:
#   same-origin                    the Jarvis server in server/ serves the app
#                                  itself (the Dockerfile sets this for you)
#   https://jarvis.example.com     a backend at another address (needs CORS,
#                                  see ALLOWED_ORIGINS below)
#   (empty)                        demo mode, unless the Supabase values are set
VITE_JARVIS_API_URL=

# Alternative backend: Supabase. Only used when VITE_JARVIS_API_URL is empty.
# See docs/backend.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy "anon" key works too.
# VITE_SUPABASE_ANON_KEY=

# ════════════════════════════════════════════════════════════════════════════
# 2. The Jarvis server (npm start, or the Docker image)
# ════════════════════════════════════════════════════════════════════════════

# ── Basics ──────────────────────────────────────────────────────────────────
# Where the database file goes. On a host, point this at a volume (/data in
# the Docker image). Default: ./data
DATA_DIR=
# Port to listen on. Railway and Render set this themselves. Default: 8080
PORT=

# ── Your account ────────────────────────────────────────────────────────────
# Creates the owner the first time the server starts (only if there is no
# owner yet). Or leave empty and run: npm run owner -- --email you@example.com
OWNER_EMAIL=
OWNER_PASSWORD=

# ── Talk to Jarvis (voice) ──────────────────────────────────────────────────
# ElevenLabs → Developers → API keys, and your agent's id.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Finished calls from ElevenLabs ──────────────────────────────────────────
# The secret ElevenLabs shows for the post-call webhook pointed at
# https://<your Jarvis>/hooks/elevenlabs
ELEVENLABS_WEBHOOK_SECRET=
# Only for calls without a phone number (test calls from the dashboard):
# which shop an agent answers for. agent_id=+15125550142, comma-separated.
ELEVENLABS_AGENT_SHOPS=

# ── Texts and calls to you (Twilio) ─────────────────────────────────────────
# Lets Jarvis text or call you about alerts, as chosen in Settings. Also
# used for the Twilio line in Settings → Connections.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number Jarvis texts and calls you from, E.164 (+15125550100).
TWILIO_FROM_NUMBER=

# ── Sign-in codes by email (Resend) ─────────────────────────────────────────
# Without these, sign in with your password; "Email me a code" says it isn't
# set up.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Jarvis <jarvis@yourdomain.com>
MAIL_FROM=

# ── Coding tasks (your task runner, docs/runner.md) ─────────────────────────
TASK_RUNNER_URL=
TASK_RUNNER_KEY=
# Signs everything pushed to https://<your Jarvis>/hooks/events (the runner,
# a booking system, scripts/send-webhook.mjs). A long random string.
JARVIS_WEBHOOK_SECRET=

# ── Notion (status check only, for now) ─────────────────────────────────────
NOTION_API_KEY=

# ── Rarely needed ───────────────────────────────────────────────────────────
# Other sites allowed to call the API (only when the app is hosted
# separately), comma-separated, e.g. https://jarvis-app.vercel.app
ALLOWED_ORIGINS=
# Proxy hops in front of the server, for the address used by rate limits.
# Detected on Railway and Render; set 1 behind any other single proxy.
TRUST_PROXY=
# Where the built app is. Default: ./dist
STATIC_DIR=
