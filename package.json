{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:server-app": "VITE_JARVIS_API_URL=same-origin npm run build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local server/src/main.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --watch server/src/main.ts",
    "owner": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local server/scripts/owner.ts",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local server/scripts/seed.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"server/test/**/*.test.ts\"",
    "lint": "oxlint",
    "test:db": "supabase/tests/run.sh",
    "test:functions": "cd supabase/functions && deno test --no-lock tests/"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.23.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-query": "^5.108.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
